/* Editorial industrial: warm paper ink, hairline grid, system serif headings. */
QWidget { color: #e3ddcf; background: transparent; font-size: 13px; }
QMainWindow, QDialog, QWidget#centralWidget { background: #1c1c1c; }
QFrame#sidebar { background: #222222; border-right: 1px solid #494949; }
QFrame#apiCard, QFrame#statCard, QFrame#panel { background: #262626; border: 1px solid #494949; border-radius: 0px; }
QFrame#apiCard:hover { border-color: #91866b; }
QFrame#providerHeader { border-top: 1px solid #626262; }
QLabel#brand { color: #e6decb; font-size: 24px; }
QLabel#pageTitle { font-size: 36px; color: #eee5d4; }
QLabel#providerTitle { font-size: 23px; color: #d4c9b1; }
QLabel#dialogTitle { font-size: 28px; color: #eee5d4; }
QLabel#pageSubtitle { color: #a69e8c; font-size: 11px; padding-bottom: 14px; }
QLabel#muted { color: #bab4a3; }
QLabel#hint, QLabel#section { color: #a9a18e; font-size: 11px; }
QLabel#cardTitle { font-size: 15px; font-weight: 600; }
QLabel#statValue { font-size: 27px; color: #dbd0b7; }
QLabel#balanceValue { font-size: 34px; color: #e9dfc9; }
QLabel#usageValue { color: #c2b087; font-weight: 600; }
QLabel#emptyState { color: #bab4a3; font-size: 15px; padding: 45px; }
QLabel#errorText { color: #d4a29b; }
QLabel#statusBadge { border: 1px solid #585858; border-radius: 0px; padding: 3px 7px; font-size: 11px; }
QLabel#statusBadge[state="unqueried"] { color: #aaa491; }
QLabel#statusBadge[state="success"] { border-color: #858585; color: #d1d1c9; }
QLabel#statusBadge[state="warning"] { border-color: #9f885d; color: #ddbf84; }
QLabel#statusBadge[state="error"] { border-color: #966d65; color: #dbaca3; }
QPushButton, QToolButton { background: #303030; border: 1px solid #606060; border-radius: 0px; padding: 8px 12px; color: #ddd6c4; }
QPushButton:hover, QToolButton:hover { background: #3b3b3b; border-color: #b4a279; }
QPushButton:pressed { background: #444444; }
QPushButton#primary { background: #c4b28b; color: #202020; border-color: #c4b28b; font-weight: 600; }
QPushButton#primary:hover { background: #ddd0af; }
QPushButton#danger { color: #dbaca3; background: transparent; }
QPushButton:disabled { background: #2c2c2c; color: #858585; border-color: #474747; }
QToolButton#navButton { background: transparent; border: 1px solid transparent; text-align: left; padding: 12px 7px; font-size: 12px; }
QToolButton#navButton:checked { border: 1px solid #777777; background: #383838; color: #f0e6ce; }
QToolButton#navButton:hover { background: #303030; }
QLineEdit, QComboBox, QTextBrowser { background: #202020; border: 1px solid #555555; border-radius: 0px; padding: 9px; selection-background-color: #646464; }
QLineEdit:focus, QComboBox:focus { border-color: #c4b28b; }
QLineEdit:read-only { color: #a9a18e; }
QComboBox QAbstractItemView { background: #303030; selection-background-color: #5c5c5c; }
QTextBrowser { padding: 18px; }
QTreeWidget, QTableWidget { background: #252525; border: none; outline: none; gridline-color: #494949; }
QTreeWidget::item { padding: 11px 5px; border-bottom: 1px solid #3b3b3b; }
QTreeWidget::item:selected, QTableWidget::item:selected { background: #444444; color: #f0e6ce; }
QTreeWidget::item:hover { background: #333333; }
QHeaderView::section { background: #2d2d2d; border: none; border-bottom: 1px solid #626262; padding: 14px 4px; color: #b8af97; font-size: 11px; }
QTableWidget::item { padding: 8px; }
QProgressBar { background: #414141; border: none; border-radius: 0px; min-height: 4px; max-height: 4px; }
QProgressBar::chunk { background: #b6b6aa; }
QProgressBar[state="warning"]::chunk { background: #c8ab72; }
QProgressBar[state="error"]::chunk { background: #ba887c; }
QScrollArea { border: none; }
QScrollBar:vertical { background: transparent; width: 6px; margin: 0; }
QScrollBar::handle:vertical { background: #646464; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { background: #383838; color: #e3ddcf; border: 1px solid #7b7b7b; padding: 6px; }
